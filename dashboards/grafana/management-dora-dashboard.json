      "options": { "reduceOptions": { "calcs": ["mean"] } },
      "title": "Lead Time for Changes (Target: < 2h)",
      "type": "stat",
      "targets": [{ "expr": "avg(pipeline_commit_to_prod_duration_seconds) / 60", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": {
