{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "NovaPay Live Ingress & Canary Traffic Split",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80, "gradientMode": "none" },
          "mappings": [],
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "RPS by Deployment Variant (Stable vs Canary)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{destination_workload=\"novapay-payment-service\"}[1m])) by (destination_version)",
          "legendFormat": "{{ destination_version }}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.0003 },
              { "color": "red", "value": 0.0005 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "title": "Canary HTTP 5xx Ratio (SLO: < 0.05%)",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{destination_workload=\"novapay-payment-service\", response_code=~\"5.*\"}[2m])) / sum(rate(istio_requests_total{destination_workload=\"novapay-payment-service\"}[2m]))",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 150 }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "title": "Canary P99 Latency (SLO: < 150ms)",
      "type": "gauge",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(istio_request_duration_milliseconds_bucket{destination_workload=\"novapay-payment-service\"}[2m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "title": "Database Connection Pool & Infrastructure Saturation",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 6,
      "title": "HikariCP Connection Pool Utilization",
      "type": "timeseries",
      "targets": [
        {
          "expr": "hikaricp_connections_active{pool=\"NovaPayDBPool\"} / hikaricp_connections_max{pool=\"NovaPayDBPool\"}",
          "legendFormat": "Pool Utilization",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prom-prod" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 7,
      "title": "Pod CPU & Memory Utilization vs Limits",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container=\"payment-api\"}[2m])) by (pod)",
          "legendFormat": "CPU - {{ pod }}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["banking", "ops", "novapay", "canary"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "NovaPay - Engineering Operations Dashboard",
  "uid": "novapay-eng-ops"
}
